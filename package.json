{
  "name": "avatar64",
  "version": "1.0.1",
  "description": "Bulletproof browser-only utilities to convert profile pictures to WebP base64 text and render base64 back into images.",
  "license": "MIT",
  "author": "Binidu01",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Binidu01/avatar64.git"
  },
  "bugs": {
    "url": "https://github.com/Binidu01/avatar64/issues"
  },
  "homepage": "https://github.com/Binidu01/avatar64#readme",
  "keywords": [
    "avatar",
    "profile-picture",
    "base64",
    "webp",
    "image",
    "image-conversion",
    "browser",
    "canvas",
    "typescript",
    "image-optimization",
    "profile-avatar",
    "webp-converter"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "build:prod": "tsup src/index.ts --format esm,cjs --dts --clean --minify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "echo \"Note: Tests require browser environment. See test/manual for testing instructions.\"",
    "prepublishOnly": "npm run typecheck && npm run build:prod",
    "prepack": "npm run build:prod"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
